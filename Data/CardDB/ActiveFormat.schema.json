{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wandbound.active-format.schema.1",
  "title": "Wandbound Active Format v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format_id",
    "format_version",
    "authority",
    "approval_date",
    "format_digest",
    "source_provenance",
    "main_deck",
    "setup_kit",
    "opening",
    "randomization",
    "turn_one",
    "game_start_addendum"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "format_id": { "const": "active_format_v1" },
    "format_version": { "const": 1 },
    "authority": { "const": "product_owner_approved" },
    "approval_date": { "const": "2026-07-30" },
    "format_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "main_deck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_size",
        "maximum_size",
        "unique_definition_ids",
        "requires_non_hybrid_character",
        "legal_categories",
        "excluded_categories"
      ],
      "properties": {
        "minimum_size": { "const": 1 },
        "maximum_size": { "const": 30 },
        "unique_definition_ids": { "const": true },
        "requires_non_hybrid_character": { "const": true },
        "legal_categories": {
          "const": ["character", "wand", "action"]
        },
        "excluded_categories": {
          "const": ["trap", "npc"]
        }
      }
    },
    "setup_kit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trap_count",
        "npc_count",
        "definition_ids_may_repeat"
      ],
      "properties": {
        "trap_count": { "const": 2 },
        "npc_count": { "const": 2 },
        "definition_ids_may_repeat": { "const": true }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hand_count", "mirrored_decks_allowed"],
      "properties": {
        "hand_count": { "const": 6 },
        "mirrored_decks_allowed": { "const": true }
      }
    },
    "randomization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seeded_shuffle",
        "seeded_first_player_coin_flip",
        "first_player_policy"
      ],
      "properties": {
        "seeded_shuffle": { "const": true },
        "seeded_first_player_coin_flip": { "const": true },
        "first_player_policy": { "const": "seeded_coin_flip" }
      }
    },
    "turn_one": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_player_only",
        "neutral_row_summons_allowed",
        "opponent_half_summons_allowed",
        "protected_region_boundary_crossing_allowed",
        "neutral_npc_attacks_allowed",
        "opponent_controlled_attacks_allowed"
      ],
      "properties": {
        "first_player_only": { "const": true },
        "neutral_row_summons_allowed": { "const": true },
        "opponent_half_summons_allowed": { "const": false },
        "protected_region_boundary_crossing_allowed": { "const": false },
        "neutral_npc_attacks_allowed": { "const": true },
        "opponent_controlled_attacks_allowed": { "const": false }
      }
    },
    "game_start_addendum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "game_start_turn_one_v1" },
        "version": { "const": 1 }
      }
    }
  }
}
