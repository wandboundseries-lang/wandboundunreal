{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wandbound.production-match-spec.schema.2",
  "title": "Wandbound Production Match Specification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "match_id",
    "seed",
    "expected_first_player",
    "opening_hand_count",
    "definition_bundle_digest",
    "active_format",
    "game_start_addendum",
    "players",
    "markers"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "match_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "seed": { "type": "integer", "minimum": 1 },
    "expected_first_player": { "enum": [0, 1] },
    "opening_hand_count": { "const": 6 },
    "definition_bundle_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "active_format": { "$ref": "#/$defs/authority_reference" },
    "game_start_addendum": { "$ref": "#/$defs/authority_reference" },
    "players": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/player" }
    },
    "markers": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/marker" }
    }
  },
  "$defs": {
    "authority_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "const": 1 },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 8 },
        "y": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "setup_kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traps", "npcs"],
      "properties": {
        "traps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "npcs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_id",
        "hero_definition_id",
        "hero_spawn",
        "ordered_main_deck",
        "setup_kit"
      ],
      "properties": {
        "player_id": { "enum": [0, 1] },
        "hero_definition_id": { "type": "string", "minLength": 1 },
        "hero_spawn": { "$ref": "#/$defs/tile" },
        "ordered_main_deck": {
          "type": "array",
          "minItems": 7,
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "setup_kit": { "$ref": "#/$defs/setup_kit" }
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_id",
        "type",
        "tile",
        "definition_id",
        "placement_order"
      ],
      "properties": {
        "player_id": { "enum": [0, 1] },
        "type": { "enum": ["trap", "npc"] },
        "tile": { "$ref": "#/$defs/tile" },
        "definition_id": { "type": "string", "minLength": 1 },
        "placement_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        }
      }
    }
  }
}
