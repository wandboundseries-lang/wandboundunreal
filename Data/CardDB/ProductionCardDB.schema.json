{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wandbound.production-carddb.schema.1",
  "title": "Wandbound Production CardDB Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_schema_version",
    "carddb_version",
    "source_version",
    "bundle_kind",
    "cards"
  ],
  "properties": {
    "bundle_schema_version": {
      "const": 1
    },
    "carddb_version": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "bundle_kind": {
      "enum": [
        "production",
        "test",
        "development"
      ]
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "test_only": {
          "type": "boolean"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "card_id",
        "public_name",
        "kind",
        "public_category",
        "source_manifest",
        "stats"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "card_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "public_name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "character",
            "hero",
            "wand",
            "action",
            "trap",
            "npc"
          ]
        },
        "public_text": {
          "type": "string"
        },
        "public_category": {
          "type": "string",
          "minLength": 1
        },
        "factions": {
          "type": "array",
          "items": {
            "enum": [
              "black_meridian",
              "csn",
              "wandwright",
              "officer",
              "marrow_syndicate"
            ]
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "uniqueItems": true
        },
        "source_manifest": {
          "type": "string"
        },
        "stats": {
          "type": "object"
        },
        "movement": {
          "type": "object"
        },
        "attack": {
          "type": "object"
        },
        "hero": {
          "type": "object"
        },
        "equip": {
          "type": "object"
        },
        "activated_effects": {
          "type": "array"
        }
      }
    }
  }
}
