{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wandbound.production-carddb.schema.1",
  "title": "Wandbound Production CardDB Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_schema_version",
    "carddb_version",
    "source_version",
    "bundle_kind",
    "cards"
  ],
  "properties": {
    "bundle_schema_version": {
      "const": 1
    },
    "carddb_version": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "bundle_kind": {
      "enum": [
        "production",
        "test",
        "development"
      ]
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "test_only": {
          "type": "boolean"
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "card_id",
        "public_name",
        "kind",
        "public_category",
        "source_manifest",
        "stats"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "card_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "public_name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "character",
            "hero",
            "hybrid",
            "wand",
            "action",
            "trap",
            "npc"
          ]
        },
        "public_text": {
          "type": "string"
        },
        "public_category": {
          "type": "string",
          "minLength": 1
        },
        "factions": {
          "type": "array",
          "items": {
            "enum": [
              "black_meridian",
              "csn",
              "wandwright",
              "officer",
              "marrow_syndicate"
            ]
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "uniqueItems": true
        },
        "source_manifest": {
          "type": "string"
        },
        "stats": {
          "type": "object"
        },
        "movement": {
          "type": "object"
        },
        "attack": {
          "type": "object"
        },
        "hero": {
          "type": "object"
        },
        "hybrid_summon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sacrifice_count",
            "sacrifice_requirement",
            "wand_payment_count",
            "wand_payment_sources",
            "hero_destination",
            "non_hero_destination"
          ],
          "properties": {
            "sacrifice_count": { "const": 1 },
            "sacrifice_requirement": { "const": "controlled_character" },
            "wand_payment_count": { "const": 1 },
            "wand_payment_sources": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "enum": ["hand", "sacrificed_unit"] }
            },
            "hero_destination": { "const": "sacrificed_hero_tile" },
            "non_hero_destination": { "const": "adjacent_to_hero" }
          }
        },
        "trap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "damage"
          ],
          "properties": {
            "damage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          }
        },
        "equip": {
          "type": "object"
        },
        "activated_effects": {
          "type": "array"
        },
        "after_damage_triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/after_damage_trigger"
          }
        },
        "pre_damage_attack_triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pre_damage_attack_trigger"
          }
        },
        "after_csn_inheritance_triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/after_csn_inheritance_trigger"
          }
        },
        "after_unit_destroyed_triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/after_unit_destroyed_trigger"
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "hybrid" } } },
          "then": { "required": ["hybrid_summon"] }
        }
      ]
    },
    "after_damage_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_id",
        "source_role",
        "damage_requirement",
        "target",
        "payloads",
        "mandatory"
      ],
      "properties": {
        "trigger_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "source_role": {
          "enum": [
            "attacker",
            "hit_unit",
            "final_damage_recipient",
            "battle_participant"
          ]
        },
        "damage_requirement": {
          "enum": [
            "damage_resolved",
            "positive_hp_damage"
          ]
        },
        "target": {
          "enum": [
            "none",
            "self",
            "attacker",
            "hit_unit",
            "final_damage_recipient",
            "opposing_battle_unit"
          ]
        },
        "payloads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "mandatory": {
          "const": true
        },
        "once_per_turn": {
          "type": "boolean"
        },
        "once_per_turn_per_opposing_unit": {
          "type": "boolean"
        }
      }
    },
    "pre_damage_attack_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_id",
        "source_role",
        "timing",
        "mandatory",
        "once_per_turn",
        "random_branch"
      ],
      "properties": {
        "trigger_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "source_role": { "const": "current_defender" },
        "timing": { "const": "after_pre_hit_before_calculate_damage" },
        "mandatory": { "const": true },
        "once_per_turn": { "const": true },
        "random_branch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "heads", "tails"],
          "properties": {
            "kind": { "const": "coin_flip" },
            "heads": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation"],
              "properties": {
                "operation": { "const": "reflect_pending_battle_hit_to_attacker" }
              }
            },
            "tails": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "amount"],
              "properties": {
                "operation": { "const": "add_pending_attack_damage" },
                "amount": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "after_csn_inheritance_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_id",
        "draw_count",
        "mandatory"
      ],
      "properties": {
        "trigger_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "draw_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "mandatory": {
          "const": true
        }
      }
    },
    "after_unit_destroyed_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_id",
        "source_scope",
        "operation",
        "required_faction",
        "mandatory"
      ],
      "properties": {
        "trigger_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "source_scope": {
          "enum": ["destroyed_self", "controlled_faction_unit_destroyed"]
        },
        "operation": {
          "enum": [
            "summon_character_from_deck_to_destroyed_tile",
            "apply_persistent_stat_delta_to_trigger_source"
          ]
        },
        "required_faction": {
          "enum": ["csn", "wandwright", "officer", "marrow_syndicate"]
        },
        "summon_count": {
          "const": 1
        },
        "mandatory": {
          "const": true
        },
        "ignore_summoning_conditions": {
          "const": true
        },
        "apply_csn_inheritance": {
          "const": true
        },
        "target": {
          "const": "trigger_source"
        },
        "stat_delta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["atk_delta", "max_hp_delta", "current_hp_delta"],
          "properties": {
            "atk_delta": { "type": "integer" },
            "max_hp_delta": { "type": "integer" },
            "current_hp_delta": { "type": "integer" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": { "const": "summon_character_from_deck_to_destroyed_tile" }
            }
          },
          "then": {
            "properties": { "source_scope": { "const": "destroyed_self" } },
            "required": ["summon_count", "ignore_summoning_conditions", "apply_csn_inheritance"]
          }
        },
        {
          "if": {
            "properties": {
              "operation": { "const": "apply_persistent_stat_delta_to_trigger_source" }
            }
          },
          "then": {
            "properties": { "source_scope": { "const": "controlled_faction_unit_destroyed" } },
            "required": ["target", "stat_delta"]
          }
        }
      ]
    }
  }
}
